<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        usesCleartextTraffic 只为了让「WebDAV 允许 http」这个**用户显式勾选**的选项真正生效：
        Android 从 API 28 起默认禁止明文 HTTP，平台层会把 http 请求打回去，
        应用内自己的校验管不到平台策略。真正的闸门在应用里：
        BackupSyncEngine/WebDavClient.validate() 默认只接受 https，
        用户必须手动打开「允许 http（不安全）」并看到红色警告。
        厂商用量接口一律走 https，不受影响。
    -->

    <application
        android:name=".ApiMeterApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApiMeterWear"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ApiMeterWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== 表盘 complication：每家厂商一个信息位 ==================== -->

        <service
            android:name=".complication.OverviewComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_provider_default"
            android:label="@string/complication_overview_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <service
            android:name=".complication.OpenAiComplicationService"
